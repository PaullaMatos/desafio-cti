{
  "name": "inventario-cti-cypress-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E Cypress para o sistema Inventario CTI",
  "scripts": {
    "cy:open": "cypress open --browser chrome",
    "cy:open:chrome": "cypress open --browser chrome",
    "cy:open:electron": "cypress open --browser electron",
    "cy:run": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports/mochawesome,overwrite=false,html=false,json=true,timestamp=mmddyyyy_HHMMss",
    "test:e2e": "npm run cy:run",
    "clean:reports": "rimraf cypress/reports/mochawesome cypress/reports/html cypress/reports/merged",
    "report": "node scripts/generate-report.mjs"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "cypress": "15.15.0",
    "dotenv": "16.4.5",
    "mochawesome": "7.1.3",
    "mochawesome-merge": "4.3.0",
    "mochawesome-report-generator": "6.2.0",
    "rimraf": "5.0.10",
    "typescript": "5.9.3"
  }
}
