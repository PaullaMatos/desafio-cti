{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["cypress", "node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["cypress/support/e2e.d.ts"],
  "include": ["cypress/**/*.ts", "cypress/**/*.d.ts", "cypress.config.ts", "scripts/**/*.mjs"]
}
